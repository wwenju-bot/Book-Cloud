<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.book.novel.mapper.NovelArchitectureVersionMapper">

	<resultMap type="NovelArchitectureVersion" id="NovelArchitectureVersionResult">
		<id     property="versionId"      column="version_id"      />
		<result property="projectId"      column="project_id"      />
		<result property="versionNo"      column="version_no"      />
		<result property="content"        column="content"         />
		<result property="source"         column="source"          />
		<result property="reviewStatus"   column="review_status"   />
		<result property="reviewComment"  column="review_comment"  />
		<result property="kbFilePath"     column="kb_file_path"    />
		<result property="createBy"       column="create_by"       />
		<result property="createTime"     column="create_time"     />
		<result property="updateBy"       column="update_by"       />
		<result property="updateTime"     column="update_time"     />
		<result property="remark"         column="remark"          />
	</resultMap>

	<sql id="selectVersionVo">
		select version_id, project_id, version_no, content, source, review_status, review_comment, kb_file_path,
			create_by, create_time, update_by, update_time, remark
		from novel_architecture_version
	</sql>

	<select id="selectVersionById" parameterType="Long" resultMap="NovelArchitectureVersionResult">
		<include refid="selectVersionVo"/>
		where version_id = #{versionId}
	</select>

	<select id="selectVersionsByProjectId" parameterType="Long" resultMap="NovelArchitectureVersionResult">
		<include refid="selectVersionVo"/>
		where project_id = #{projectId}
		order by version_no desc
	</select>

	<select id="selectMaxVersionNo" parameterType="Long" resultType="Integer">
		select ifnull(max(version_no), 0) from novel_architecture_version where project_id = #{projectId}
	</select>

	<insert id="insertVersion" parameterType="NovelArchitectureVersion" useGeneratedKeys="true" keyProperty="versionId">
		insert into novel_architecture_version(
			project_id, version_no, content, source, review_status, kb_file_path, create_by, create_time
		)values(
			#{projectId}, #{versionNo}, #{content}, #{source}, #{reviewStatus}, #{kbFilePath}, #{createBy}, sysdate()
		)
	</insert>

	<update id="updateVersion" parameterType="NovelArchitectureVersion">
		update novel_architecture_version
		<set>
			<if test="content != null">content = #{content},</if>
			<if test="reviewStatus != null and reviewStatus != ''">review_status = #{reviewStatus},</if>
			<if test="reviewComment != null">review_comment = #{reviewComment},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			update_time = sysdate()
		</set>
		where version_id = #{versionId}
	</update>

</mapper>
